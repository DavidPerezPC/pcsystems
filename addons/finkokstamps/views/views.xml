<odoo>
  <data>
    <!-- explicit list view definition -->
    <record model="ir.ui.view" id="finkok_vats_list">
      <field name="name">Finkok Stamps Vats</field>
      <field name="model">finkokstamps.vats</field>
      <field name="arch" type="xml">
        <list>
          <field name="vat"/>
          <field name="name" />
          <field name="partner_id"/>
          <field name="active"/>
        </list>
      </field>
    </record>

    <record id="finkok_vats_form" model="ir.ui.view">
        <field name="name">VATS Form</field>
        <field name="model">finkokstamps.vats</field>
        <field name="arch" type="xml">
            <form string="VATS">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="vat"/>
                            <field name="partner_id"/>
                            <field name="active" />
                        </group>
                    </group>
                    <notebook>
                        <page string="Stamps">
                            <field name="stamps_ids">
                                <list>
                                  <field name="date"/>
                                  <field name="stamps"/>
                                  <field name="canceled"/>                                
                                </list>
                            </field>            
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="finkok_vats_filters" model="ir.ui.view">
        <field name="name">VAT's Filters</field>
        <field name="model">finkokstamps.vats</field>
        <field name="arch" type="xml">
            <search string="VATS">
                <field name="vat" />
                <field name="partner_id"/>
                <group string="Group By">
                  <filter string="VAT" name="grp_sync_vat"
                          context="{'group_by':'vat'}"/>
                  <filter string="Partner" name="grp_sync_partner"
                          context="{'group_by':'partner_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record model="ir.ui.view" id="finkok_stamps_list">
      <field name="name">Finkok Stamps List</field>
      <field name="model">finkokstamps.stamps</field>
      <field name="arch" type="xml">
        <list>
          <field name="vat_id"/>
          <field name="name" />
          <field name="date"/>
          <field name="stamps"/>
          <field name="canceled"/>
        </list>
      </field>
    </record>

    <!-- actions opening views on models -->
    <record model="ir.actions.act_window" id="finkok_vats_action_window">
      <field name="name">Finkok Vats</field>
      <field name="res_model">finkokstamps.vats</field>
      <field name="view_id" ref="finkok_vats_list"/>
      <field name="view_mode">list,form</field>
      <field name="search_view_id" ref="finkok_vats_filters"/>
    </record>

    <record model="ir.actions.act_window" id="finkok_stamps_action_window">
      <field name="name">Finkok Stamps</field>
      <field name="res_model">finkokstamps.stamps</field>
      <field name="view_id" ref="finkok_stamps_list"/>
      <field name="view_mode">list,form</field>
    </record>

    <!-- server action to the one above -->
<!--
    <record model="ir.actions.server" id="finkok_stamps.action_server">
