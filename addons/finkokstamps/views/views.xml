        }
      </field>
    </record>
-->

    <!-- Top menu item -->
    <menuitem parent="account.menu_finance_receivables" name="Finkok" 
          id="menu_action_finkok"
          sequence="120"/>

    <menuitem name="VATS" id="menu_action_finkok_vats" 
      parent="menu_action_finkok"
      action="finkok_vats_action_window"
      sequence="1"
      />

    <menuitem name="Stamps" id="menu_action_finkok_stamps" 
      parent="menu_action_finkok"
      action="finkok_stamps_action_window"
      sequence="10"
      />
