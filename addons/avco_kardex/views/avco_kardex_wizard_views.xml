<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_avco_kardex_wizard_form" model="ir.ui.view">
        <field name="name">avco.kardex.wizard.form</field>
        <field name="model">avco.kardex.wizard</field>
        <field name="arch" type="xml">
            <form string="Kardex AVCO">
                <sheet>
                    <group>
                        <group string="Período">
                            <field name="date_from"/>
                            <field name="date_to"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group string="Filtro de productos">
                            <field name="product_ids"
                                   widget="many2many_tags"
                                   options="{'no_create': True}"
                                   placeholder="Todos los productos con costo promedio"/>
                        </group>
                    </group>
                    <notebook invisible="not line_ids">
                        <page string="Kardex" name="kardex">
                            <field name="line_ids" nolabel="1">
                                <list string="Kardex AVCO"
                                      create="false" edit="false" delete="false"
                                      decoration-success="tipo == 'IN'"
                                      decoration-danger="tipo == 'OUT'"
                                      decoration-warning="tipo == 'INICIO'"
                                      decoration-muted="tipo == 'INT'"
                                      decoration-info="tipo == 'TOTAL'"
                                      decoration-bf="tipo == 'TOTAL'">
                                    <field name="producto"/>
                                    <field name="fecha"/>
                                    <field name="tipo"/>
                                    <field name="move_id" optional="hide"/>
                                    <field name="ref"/>
                                    <field name="existencia_anterior"/>
                                    <field name="entrada"/>
                                    <field name="salida"/>
                                    <field name="costo_movimiento"/>
                                    <field name="nuevo_costo"/>
                                    <field name="existencia"/>
                                    <field name="valor_inventario"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <footer>
                    <button name="action_run"
                            type="object"
                            string="Generar Kardex"
                            class="btn-primary"/>
                    <button name="action_export_excel"
                            type="object"
                            string="Exportar Excel"
                            class="btn-secondary"
                            invisible="not line_ids"/>
                    <button string="Cerrar"
                            class="btn-secondary"
                            special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Acción desde lista/form de product.product -->
    <record id="action_avco_kardex_wizard" model="ir.actions.act_window">
        <field name="name">Kardex AVCO</field>
        <field name="res_model">avco.kardex.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="product.model_product_product"/>
        <field name="binding_view_types">list,form</field>
    </record>

    <!-- Acción desde lista/form de product.template -->
    <record id="action_avco_kardex_wizard_tmpl" model="ir.actions.act_window">
        <field name="name">Kardex AVCO</field>
        <field name="res_model">avco.kardex.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="product.model_product_template"/>
        <field name="binding_view_types">list,form</field>
    </record>

</odoo>
