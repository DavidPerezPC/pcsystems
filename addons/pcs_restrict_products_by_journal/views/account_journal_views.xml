<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="account_journal_view_form_inherited" model="ir.ui.view">
            <field name="name">account.journal.form</field>
            <field name="model">account.journal</field>
            <field name="inherit_id" ref="account.view_account_journal_form"/>
            <field name="arch" type="xml">
                <xpath expr="//group[@name='group_edi_config']" position="after">
                    <group string="Product Restrictions" 
                           name="group_product_restrictions"
                           invisible="type != 'purchase'" 
                           groups="account.group_account_manager">
                        <field name="allowed_product_ids" widget="many2many_tags"
                            placeholder="All products will be available if empty..."/>
                    </group>
                </xpath>
            </field>
        </record>
    </data>
</odoo>