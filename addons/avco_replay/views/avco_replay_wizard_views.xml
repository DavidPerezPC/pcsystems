<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_avco_replay_wizard_form" model="ir.ui.view">
        <field name="name">avco.replay.wizard.form</field>
        <field name="model">avco.replay.wizard</field>
        <field name="arch" type="xml">
            <form string="Replay AVCO">
                <sheet>
                    <group>
                        <group string="Parámetros">
                            <field name="date_from"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="include_landed_costs"/>
                        </group>
                        <group string="Modo de ejecución">
                            <field name="apply_changes"/>
                            <field name="rewrite_moves" invisible="not apply_changes"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Productos" name="products">
                            <field name="line_ids">
                                <list editable="bottom">
                                    <field name="product_id"/>
                                    <field name="current_standard_price"/>
                                    <field name="manual_cost"/>
                                    <field name="computed_avco"/>
                                    <field name="computed_qty"/>
                                </list>
                            </field>
                        </page>
                        <page string="Log de resultado" name="log" invisible="not result_log">
                            <field name="result_log" widget="text" readonly="1" nolabel="1"/>
                        </page>
                    </notebook>
                </sheet>
                <footer>
                    <button name="action_run"
                            type="object"
                            string="Ejecutar"
                            class="btn-primary"/>
                    <button string="Cerrar"
                            class="btn-secondary"
                            special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_avco_replay_wizard" model="ir.actions.act_window">
        <field name="name">Replay AVCO</field>
        <field name="res_model">avco.replay.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="product.model_product_product"/>
        <field name="binding_view_types">list,form</field>
    </record>

    <record id="action_avco_replay_wizard_tmpl" model="ir.actions.act_window">
        <field name="name">Replay AVCO</field>
        <field name="res_model">avco.replay.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="product.model_product_template"/>
        <field name="binding_view_types">list,form</field>
    </record>

</odoo>
