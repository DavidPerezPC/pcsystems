<odoo>
    <record model="ir.ui.view" id="view_purchase_order_form_ferommis">
        <field name="name">view.purchase.order.form.ferommis</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='picking_type_id']" position="after">
                <field name="delivery_address"/>
            </xpath>
        </field>
    </record>

    <record model="ir.ui.view" id="view_purchase_order_list_ferommis">
        <field name="name">view.purchase.order.list.ferommis</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_kpis_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='date_order']" position="after">
                <field name="purchase_manual_currency_rate"/>
            </xpath>
        </field>
    </record>

    <record model="ir.ui.view" id="view_purchase_order_list_ferommis_confirmed">
        <field name="name">view.purchase.order.list.ferommis.confirmed</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_view_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='date_order']" position="after">
                <field name="purchase_manual_currency_rate"/>
            </xpath>
        </field>
    </record>
</odoo>